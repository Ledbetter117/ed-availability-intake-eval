# Secrets — never commit keys. This file must exist in the FIRST commit.
.env
.env.*
*.key
*_API_KEY*

# Raw API responses (regenerable; may be large) — covers results/, results_haiku/, any future per-model dirs
results*/raw/

# Python
__pycache__/
*.pyc
.venv/

# OS/editor
.DS_Store
Thumbs.db

# Real-world artifacts — NEVER commit or publish (employer data, internal identifiers)
data_private/

# Arm B private mapping — abstract document IDs to real photo filenames, months and the
# writer's own encodings. The ONLY place those appear. Never commit, never publish.
kit-B/private-map.json
probe/kit-B/private-map.json
**/private-map.json
probe-run/
probe_b_results/probe_b_results.json
kit-B/*.gold.json
probe/kit-B/*.gold.json
